{
  "name": "fintech-llm-automation",
  "version": "1.0.0",
  "description": "Secure modern LLM automation for fintech with multilayered pipeline",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon --exec node --input-type=module server/index.js",
    "client:dev": "cd client && vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "cd client && vite build",
    "build:server": "echo 'Backend ready for production'",
    "preview": "npm run build && node server/index.js",
    "test": "node --test server/**/*.test.js",
    "lint": "eslint server client/src"
  },
  "keywords": ["fintech", "llm", "automation", "ai", "security"],
  "author": "Suryansh-X",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "pg": "^8.11.3",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "openai": "^4.26.0",
    "tf-node": "^1.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2",
    "eslint": "^8.54.0"
  }
}
